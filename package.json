{
  "name": "puerto-rico",
  "version": "0.1.0",
  "description": "Cyfrowa wersja gry Puerto Rico - backend (TypeScript)",
  "type": "module",
  "main": "electron-main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:app": "vite build",
    "check": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "bot:arena": "tsx tools/arena.ts",
    "bot:train": "tsx tools/train-neural.ts",
    "server": "tsx server/server.ts",
    "dist": "npm run build:app && electron-builder --win portable",
    "build:html": "vite build --config vite.config.singlefile.ts",
    "build:pages": "node --import ./tools/register-typescript.mjs tools/build-pages.mjs",
    "pages:upload": "node tools/deploy-pages-direct.mjs",
    "pages:verify": "node tools/verify-pages.mjs",
    "deploy": "npm run check && npm run check:stats && npm test && npm run build:pages && npm run pages:upload && npm run pages:verify",
    "stats:setup": "node tools/statistics-admin.mjs setup",
    "stats:list": "node tools/statistics-admin.mjs list",
    "stats:export": "node tools/statistics-admin.mjs export",
    "check:stats": "tsc -p statistics-server/tsconfig.json"
  },
  "build": {
    "appId": "pl.puertorico.game",
    "productName": "Puerto Rico",
    "electronDist": "./node_modules/electron/dist",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.7",
    "wrangler": "4.114.0"
  },
  "dependencies": {
    "express": "^4.21.0",
    "pixi.js": "^8.20.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.18.0"
  }
}
